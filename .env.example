# ---------------------------------------------------------------------------
# COMETHICAL — mobile app environment (copy to .env and fill in)
# Leave both values empty to run in LOCAL DEMO MODE (no backend needed).
# Only EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: public web address of the app (e.g. https://your-app.expo.app). Admin invite
# links point here so they open on any device. Without it, links use the current web
# address, or an app link (comethical://invite/...) on phones.
EXPO_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Server-side secrets — DO NOT put these in .env for the app.
# Set them as Supabase Edge Function secrets instead:
#   npx supabase secrets set GEMINI_API_KEY=... ADMIN_API_KEY=...
# Listed here only for documentation.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest
# ADMIN_API_KEY=a-long-random-string-for-admin-endpoints
# AUTO_APPROVE_VALIDATED=false
# GENERATION_HOURLY_LIMIT=10
